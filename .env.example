# Discord Bot Token
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Admin Configuration
# Comma-separated list of Discord user IDs with admin privileges
# These users can use the /config command to change settings
ADMIN_USER_IDS=

# Redis Configuration
# Use Redis for persistent configuration storage (recommended for cloud deployments)
# Set USE_REDIS=true to enable Redis
USE_REDIS=false
# Redis URL (required if USE_REDIS=true)
# Example: rediss://default:password@host:6379
REDIS_URL=

# System Monitor Settings
# Set to "true" to enable, "false" to disable (default: true)
SYSTEM_MONITOR_ENABLED=true

# Health Check Settings
# Set to "true" to enable, "false" to disable (default: true)
HEALTH_CHECK_ENABLED=true
PORT=8000

# Anonymous Board Settings
# Channel ID where the button will be displayed
ANONYMOUS_BUTTON_CHANNEL_ID=

# Channel ID where anonymous messages will be posted
ANONYMOUS_POST_CHANNEL_ID=

# Auto delete time in seconds (0 to disable auto-delete, max: 604800 = 7 days)
ANONYMOUS_MESSAGE_DELETE_SECONDS=86400
